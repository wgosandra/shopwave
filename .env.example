# ShopWave environment.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Each block says which build phase first needs it; nothing here is a real secret.

# ---------------------------------------------------------------------------
# Phase 1 — foundation (needed now)
# ---------------------------------------------------------------------------

# Public base URL of this deployment. Used for canonical URLs, Open Graph
# images and the Midtrans redirect back from the payment page.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Phase 2 — database (needed for `prisma migrate`)
# ---------------------------------------------------------------------------

# Matches the credentials in docker-compose.yml. Run `npm run db:up` first.
DATABASE_URL="postgresql://shopwave:shopwave@localhost:5432/shopwave?schema=public"

# ---------------------------------------------------------------------------
# Phase 3 — authentication (Auth.js)
# ---------------------------------------------------------------------------

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Only needed when the deployment sits behind a proxy that rewrites the host.
# AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Phase 6 — payments (Midtrans sandbox)
# ---------------------------------------------------------------------------

# From the Midtrans sandbox dashboard: Settings > Access Keys.
# The server key is secret. The client key is safe to expose.
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Minutes an unpaid order is held before it expires and its stock is restored.
ORDER_EXPIRY_MINUTES="60"
